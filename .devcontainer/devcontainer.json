{
  "name": "Delphi",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "python3 -m pip install --require-hashes -r requirements.txt",
  "postStartCommand": "bash .devcontainer/start.sh",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Delphi",
      "onAutoForward": "openBrowser"
    }
  }
}
